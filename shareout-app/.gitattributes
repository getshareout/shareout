# Generated / embedded-bundle files — machine-produced, not hand-authored.
# Collapse them in code review (architecture_plan §2 principle 2).
# Regenerated via scripts/embed-*.mjs, scripts/stage-*.mjs, and `npm run build:brand`.
src/sdk-mobile-serve.ts linguist-generated=true
src/sdk-charts-serve.ts linguist-generated=true
public/_bundles/*.js linguist-generated=true
**/*.generated.ts linguist-generated=true

# Committed generated outputs that PRs regenerate in parallel. `merge=generated` keeps one
# side on rebase/merge instead of conflicting (driver set by tooling/scripts/install-hooks.sh;
# without it git conflicts as before). check:bundles in pre-push then rebuilds them and
# fails if the committed copy is stale — regenerate and commit, never hand-merge.
# Only files check:bundles regenerates belong here (grid.*, page-pilot.js are not).
public/_bundles/chat-core.js merge=generated
public/_bundles/editor.js merge=generated
public/_bundles/shareout-comments-agent.js merge=generated
public/_bundles/shareout-mobile.js merge=generated
public/_bundles/shareout-sdk.js merge=generated
public/sdk/shareout.js merge=generated linguist-generated=true
public/sdk/v1/shareout.js merge=generated linguist-generated=true
public/_bundles/versions.json merge=generated linguist-generated=true
public/_bundles/skill-meta.json merge=generated linguist-generated=true
public/_bundles/skill.zip -diff -text merge=generated linguist-generated=true
src/discovery/openapi.*.json merge=generated linguist-generated=true
src/discovery/*.generated.ts merge=generated
src/official-skills/*.generated.ts merge=generated
src/data/agent/sdk-reference.generated.ts merge=generated
